# Salin ke backend/.env lalu isi. Jangan pernah di-commit.

# PostgreSQL (dev: docker compose, port 5442)
DATABASE_URL=postgresql+psycopg://harka:harka@localhost:5442/harka
# Database khusus pytest (dibuat otomatis oleh infra/postgres/init)
TEST_DATABASE_URL=postgresql+psycopg://harka:harka@localhost:5442/harka_test
REDIS_URL=redis://localhost:6390/0

# Acak >= 32 karakter: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Object storage S3-compatible (dev: zenko/cloudserver di port 9010)
S3_ENDPOINT_URL=http://localhost:9010
S3_PUBLIC_ENDPOINT_URL=http://localhost:9010
S3_ACCESS_KEY=harka-dev
S3_SECRET_KEY=harka-dev-secret
S3_BUCKET=harka-assets

# true = task dijalankan langsung di proses API (dev tanpa worker Celery)
CELERY_EAGER=true

# Asal (origin) yang boleh memanggil API dan storage dari browser. Mesin render Google Flow butuh
# https://flow.google.com dan https://labs.google (ambil foto referensi + upload cadangan, lihat flow-extension/README.md).
CORS_ORIGINS=["http://localhost:3010"]

# Render Google Flow: folder unduhan Chrome yang dipindai worker (kosong = ingest mati).
# FLOW_DOWNLOAD_DIR=/srv/flow-downloads

# Owner pertama, hanya dipakai saat tabel users masih kosong
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
