# ============================================================
#  MAKLON CONTROL ROOM — VPS SERVER CONFIGURATION (.env)
# ============================================================

# Port aplikasi
PORT=3000
NODE_ENV=production

# Email pemilik (bisa lebih dari satu, pisahkan dengan koma)
# Harus sama dengan yang terdaftar di web/config.js dan firestore.rules
OWNER_EMAILS=creatormpb25@gmail.com

# API Key Anthropic Claude (dari https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=claude-haiku-5-5

# WhatsApp Gateway (Fonnte) — opsional
FONNTE_TOKEN=your_fonnte_token_here
WA_AUTO_SEND=false
WA_AUTO_PROGRESS=false

# Lokasi file Firebase Service Account Key
# Download dari: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Atau isi JSON service account langsung (berguna untuk Docker/CI)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Sajikan file web statis langsung dari server ini? (true/false)
SERVE_STATIC=true
