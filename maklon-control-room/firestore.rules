rules_version = '2';
// Aturan akses Maklon Control Room.
// GANTI daftar email di isOwner() supaya sama dengan ownerEmails di web/config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['creatormpb25@gmail.com', 'admin@haraka.com'];
    }
    function roleDoc() { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function hasRole() { return isOwner() || (signedIn() && exists(roleDoc())); }
    function isAdmin() { return isOwner() || (hasRole() && get(roleDoc()).data.role == 'admin'); }

    // Profil nama tampilan, ditulis sendiri saat login
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    // Peran tim: hanya pemilik yang boleh mengubah
    match /roles/{uid} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    // Permintaan akses: tiap akun menulis miliknya sendiri
    match /requests/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isOwner());
    }
    // Pengaturan (nama perusahaan di pesan WA)
    match /meta/{doc} {
      allow read: if hasRole();
      allow write: if isOwner();
    }

    // Data CRM: admin penuh, pabrik hanya baca nama pelanggan
    match /customers/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    // Keuangan & leads: admin saja
    match /payments/{id} { allow read, write: if isAdmin(); }
    match /leads/{id}    { allow read, write: if isAdmin(); }
    match /followups/{id}{ allow read, write: if isAdmin(); }

    // Proyek, laporan progres, draf pesan progres: admin & pabrik
    match /projects/{id} { allow read, write: if hasRole(); }
    match /updates/{id}  { allow read, create: if hasRole(); allow update, delete: if isAdmin(); }
    match /outbox/{id}   { allow read, create: if hasRole(); allow update, delete: if isAdmin(); }
  }
}
